PORT=3000

# Secrets MUST be at least 32 chars, must differ from each other, and must not
# be left as these placeholders — the server refuses to start otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-this-too
REFRESH_TOKEN_EXPIRES_IN=7d

# In production point this at a PERSISTENT volume (e.g. /data/noteflow.db on
# Railway) or all data is lost on redeploy — see apps/api/DEPLOYMENT.md.
DB_PATH=./data/noteflow.db
# Number of daily database backups to retain (in <DB_PATH dir>/backups).
DB_BACKUP_KEEP=7

# Email (SMTP) — used for account closure notifications
# Leave empty to disable emails (feature still works, just no notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NoteFlow <noreply@noteflow.app>
